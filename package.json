{
  "name": "@blingcompany/bling-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema visual común del ecosistema Bling: tema, roles, componentes CSS, tipografías y puentes a Tailwind 3 y 4.",
  "author": "Bling Company",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/services-blingcompany/bling-ui.git"
  },
  "files": [
    "index.css",
    "css",
    "fuentes",
    "assets",
    "tailwind",
    "colors.cjs",
    "colors.d.ts",
    "scripts"
  ],
  "exports": {
    "./index.css": "./index.css",
    "./css/*": "./css/*",
    "./fuentes/*": "./fuentes/*",
    "./assets/*": "./assets/*",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./colors": {
      "types": "./colors.d.ts",
      "default": "./colors.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "verificar": "node scripts/verificar.mjs"
  }
}
