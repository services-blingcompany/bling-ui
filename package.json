{
  "name": "@blingcompany/bling-ui",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Sistema visual y marca común del ecosistema Bling: tema, roles, componentes CSS y React, íconos, tipografías y puentes a Tailwind 3 y 4.",
  "author": "Bling Company",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/services-blingcompany/bling-ui.git"
  },
  "files": [
    "index.css",
    "css",
    "fuentes",
    "assets",
    "tailwind",
    "colors.cjs",
    "colors.d.ts",
    "marca",
    "tema",
    "react",
    "scripts"
  ],
  "exports": {
    "./index.css": "./index.css",
    "./css/*": "./css/*",
    "./fuentes/*": "./fuentes/*",
    "./assets/*": "./assets/*",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./colors": {
      "types": "./colors.d.ts",
      "default": "./colors.cjs"
    },
    "./marca/*": "./marca/*",
    "./tema": {
      "types": "./tema/tema.d.ts",
      "default": "./tema/tema.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "verificar": "node scripts/verificar.mjs",
    "marca": "node scripts/generar-marca.mjs",
    "build:react": "esbuild react-src/index.jsx --bundle --format=esm --jsx=automatic --external:react --external:react/jsx-runtime --outfile=react/index.js",
    "build": "npm run marca && npm run build:react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.24.0",
    "png-to-ico": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
